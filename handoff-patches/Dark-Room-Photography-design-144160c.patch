+.site-footer .footer-section strong{
+  margin:0 0 12px;
+  color:#dbe1dc;
+  font:700 15.5px/1.15 Manrope,Arial,sans-serif;
+  letter-spacing:-.02em;
+  text-transform:none;
+}
+.site-footer .footer-navigation{grid-area:navigation}
+.site-footer .footer-business{grid-area:business}
+.site-footer .footer-booking{grid-area:booking}
+.site-footer .footer-navigation nav{
+  display:grid;
+  gap:2px;
+}
+.site-footer .footer-navigation a{
+  display:inline-flex;
+  width:fit-content;
+  min-height:24px;
+  margin:0;
+  align-items:center;
+  color:#b8c6c3;
+  font:600 9.5px/1.35 Manrope,Arial,sans-serif;
+  letter-spacing:.02em;
+}
+.site-footer .footer-navigation a:hover{color:#e2e7e2}
+.site-footer .footer-hours p{
+  max-width:100%;
+  margin:0 0 8px;
+  color:#c4cfcc;
+  font:400 11px/1.45 Manrope,Arial,sans-serif;
+}
+.site-footer .footer-hours p:last-child{
+  margin-bottom:0;
+  color:#9fb1ad;
+  font-size:10px;
+}
+.site-footer .footer-trust{
+  margin-top:12px;
+  padding-top:11px;
+  border-top:1px solid rgba(174,183,170,.16);
+}
+.site-footer .footer-trust strong{
+  margin-bottom:8px;
+  font-size:11.5px;
+  line-height:1.35;
+}
+.site-footer .footer-trust ul{
+  display:grid;
+  gap:4px;
+  margin:0;
+  padding:0;
+  list-style:none;
+}
+.site-footer .footer-trust li{
+  display:flex;
+  min-width:0;
+  gap:7px;
+  align-items:flex-start;
+  color:#aabbb7;
+  font:500 9.5px/1.35 Manrope,Arial,sans-serif;
+}
+.site-footer .footer-trust li span{
+  flex:0 0 auto;
+  color:#b88a6f;
+  font-size:10px;
+}
+.site-footer .footer-booking-button{
+  display:inline-flex;
+  width:100%;
+  max-width:100%;
+  min-width:0;
+  min-height:46px;
+  margin:0 auto;
+  padding:0 20px;
+  box-sizing:border-box;
+  align-items:center;
+  justify-content:space-between;
+  gap:18px;
+  border:1px solid rgba(174,183,170,.45);
+  background:#223a31;
+  color:#e4e9e4;
+  font:700 9px/1.2 Manrope,Arial,sans-serif;
+  letter-spacing:.1em;
+  text-align:left;
+  text-transform:uppercase;
+  white-space:normal;
+  justify-self:center;
+  transition:background-color .2s ease,border-color .2s ease,transform .2s ease;
+}
+.site-footer .footer-booking-button:hover{
+  border-color:#aeb7aa;
+  background:#2b493e;
+  color:#fff;
+  transform:translateY(-1px);
+}
+.site-footer a:focus-visible{
+  outline:2px solid #d7ded6;
+  outline-offset:4px;
+}
+.site-footer .copyright{
+  grid-area:copyright;
+  display:flex;
+  min-height:0;
+  margin:0;
+  padding-top:12px;
+  justify-content:flex-start;
+  border-top:1px solid rgba(174,183,170,.2);
+  color:#8fa29e;
+  font:500 8px/1.4 Manrope,Arial,sans-serif;
+  letter-spacing:.03em;
+}
+
+@media(max-width:860px){
+  .site-footer .site-footer-inner{
+    grid-template-columns:1.2fr 1fr;
+    grid-template-areas:
+      "brand booking"
+      "navigation business"
+      "copyright copyright";
+    gap:28px 40px;
+    padding:38px 22px 18px;
+  }
+}
+@media(max-width:600px){
+  .site-footer .site-footer-inner{
+    grid-template-columns:1fr;
+    grid-template-areas:
+      "brand"
+      "booking"
+      "navigation"
+      "business"
+      "copyright";
+    gap:24px;
+    padding:34px 22px 18px;
+  }
+  .site-header .brand img{width:42px;height:42px}
+  .site-footer .footer-brand img{width:118px;margin-bottom:12px}
+  .site-footer .footer-brand p{max-width:330px}
+  .site-footer .footer-section strong{margin-bottom:11px}
+  .site-footer .footer-booking-button{width:100%;max-width:100%}
+  .site-footer .footer-navigation nav{grid-template-columns:1fr 1fr;gap:3px 26px}
+  .site-footer .copyright{display:flex;margin:0;padding-top:11px}
+}
